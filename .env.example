# Baidu Open Platform app key (Client ID / API Key), not Client Secret.
BAIDUDISKLINK_CLIENT_ID=your-baidu-open-platform-app-key
BAIDUDISKLINK_CLIENT_SECRET=your-baidu-open-platform-client-secret
# Must exactly match the callback URL configured in Baidu Open Platform.
BAIDUDISKLINK_REDIRECT_URI=http://your-dsm-ip:8765/callback
BAIDUDISKLINK_OAUTH_SCOPE=basic,netdisk
BAIDUDISKLINK_OAUTH_STATE=baidudisklink
BAIDUDISKLINK_OAUTH_LISTEN_ADDR=0.0.0.0:8765
