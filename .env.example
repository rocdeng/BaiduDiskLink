# Baidu Open Platform app key (Client ID / API Key), not Client Secret.
BAIDUDISKLINK_CLIENT_ID=your-baidu-open-platform-app-key
BAIDUDISKLINK_CLIENT_SECRET=your-baidu-open-platform-client-secret
# Must exactly match the callback URL configured in Baidu Open Platform.
BAIDUDISKLINK_REDIRECT_URI=http://your-dsm-ip:8765/callback
# Optional: allow a specific DSM group to read the mounted files, e.g. embysvr.
BAIDUDISKLINK_FUSE_GROUP_NAME=embysvr
# Optional: host-side mount directory exposed to DSM/Emby.
# This is the mount point path, not the source code directory.
# Default "./mnt" means the mnt directory under the project root.
# Prefer a normal shared folder such as /volume1/video/BaiduDiskLink.
BAIDUDISKLINK_HOST_MOUNT_PATH=./mnt
# Optional: Baidu Netdisk directory mounted as the local root.
# Default "/Videos" means local mount root shows the contents under /Videos.
# Set to "/" if you want to expose the whole Baidu Netdisk.
BAIDUDISKLINK_REMOTE_ROOT_PATH=/Videos
BAIDUDISKLINK_OAUTH_SCOPE=basic,netdisk
BAIDUDISKLINK_OAUTH_STATE=baidudisklink
BAIDUDISKLINK_OAUTH_LISTEN_ADDR=0.0.0.0:8765
