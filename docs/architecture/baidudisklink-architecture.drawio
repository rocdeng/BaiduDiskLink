          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="620"/><mxPoint x="850" y="620"/><mxPoint x="850" y="620"/><mxPoint x="850" y="620"/><mxPoint x="850" y="730"/></Array></mxGeometry>
