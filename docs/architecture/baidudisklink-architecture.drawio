  <diagram id="04" name="04 播放读取链路">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="clientread" value="播放器 / Emby 读取&#xa;[Software System: open + read + seek]&#xa;通过 DSM 本地路径发起小块、顺序或跳转读取" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="550" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="fuseops" value="FUSE 语义层&#xa;[Component: internal/fs]&#xa;路径映射、权限、文件大小边界和 errno" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="550" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="handle" value="独立 Stream Handle&#xa;[Component: Probe / Stream / Seek]&#xa;每次 Open 独立游标；多个句柄共享 Session 与缓存" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="550" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="scheduler" value="优先级调度器&#xa;[Component: P0 / P1 / P2 / P3]&#xa;前台块、近端 64 MiB、目标 256 MiB、后向 32 MiB" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="workers" value="下载 Worker 池&#xa;[Component: 默认 8 Workers]&#xa;逐块领取任务，不等待同批慢块；支持取消和公平配额" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="360" y="740" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="hedge" value="慢块竞速与重试&#xa;[Component: 动态 P95 阈值]&#xa;P0 慢块最多竞速一次，连续慢块刷新 dlink" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="230" y="930" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="memorycache" value="内存热缓存&#xa;[Container: 默认 320 MiB]&#xa;覆盖前向窗口、后向保留与调度余量" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="550" y="1300" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="diskcache" value="磁盘临时缓存&#xa;[Container: 默认 2 GiB / 可关闭]&#xa;.part 完整后原子改名为 .chunk，按 LRU 清理" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="0" y="1300" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="exactrange" value="精确 Range 传输&#xa;[Component: internal/remote]&#xa;按 1 MiB 调度块调用底层 ReadRange" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="280" y="1110" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="dlink" value="dlink 与 HTTP 客户端&#xa;[Component: internal/baidu]&#xa;官方 API 获取直链，下载连接池执行 Range" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
