        </mxCell>
        <mxCell id="e0" value="Read(offset, length)" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="clientread" target="fuseops">
