      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="user" value="用户 / 管理员&#xa;[Person]&#xa;配置 OAuth、挂载目录并进行运维测试" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="200" height="180" as="geometry"/>
