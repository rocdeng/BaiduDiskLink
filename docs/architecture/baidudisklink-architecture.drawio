        <mxCell id="baiduopen" value="百度开放平台&#xa;[Software System: OAuth 2.0 / Netdisk API]&#xa;授权、Token 刷新、目录与文件元数据" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="0" y="610" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="baiducdn" value="百度 CDN&#xa;[Software System: HTTP Range]&#xa;提供视频文件分块内容" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="280" y="610" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="dsm" value="群晖 DSM&#xa;[Software System: Docker / FUSE / bind mount]&#xa;运行容器并向宿主机传播挂载点" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
