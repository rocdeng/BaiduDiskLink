        <mxCell id="players" value="媒体消费者&#xa;[Software System: Emby / 网易爆米花 / Infuse]&#xa;扫描媒体库、读取文件、播放与 Seek" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
