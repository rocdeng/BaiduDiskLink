        </mxCell>
        <mxCell id="e0" value="配置、授权、诊断命令" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="user" target="baidudisklink">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="370"/><mxPoint x="180" y="420"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="访问 /volume2/baidu_videos" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="players" target="dsm">
