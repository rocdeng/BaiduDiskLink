          <mxGeometry x="280" y="430" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="apiclient" value="百度元数据客户端&#xa;[Component: internal/baidu]&#xa;使用 Token 调用 List、Stat、dlink 和删除接口" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="metastore" value="SQLite 元数据缓存&#xa;[Container: /data/meta.db (WAL)]&#xa;目录树、FSID、大小、MTM、过期状态" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="550" y="430" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="fusedir" value="FUSE 目录操作&#xa;[Component: Lookup / Readdir / Getattr]&#xa;优先查询 SQLite，缺失或过期时拉取远端" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="refresh" value="刷新机制&#xa;[Component: 懒刷新 + 每分钟根目录刷新]&#xa;序列化远端刷新并更新负缓存" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
