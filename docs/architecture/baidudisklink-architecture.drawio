        <mxCell id="oauthserver" value="本地 OAuth Server&#xa;[Component: internal/auth :8765]&#xa;生成授权 URL 并接收 code" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="0" y="250" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="baiduauth" value="百度授权页 / Token API&#xa;[Software System: OAuth 2.0]&#xa;用户登录授权并返回 access_token / refresh_token" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
