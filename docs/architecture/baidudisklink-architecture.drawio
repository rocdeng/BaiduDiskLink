        <mxCell id="cdn" value="百度 CDN 节点&#xa;[Software System: HTTP/1.1 Range]&#xa;返回目标字节范围" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
